{
  "metadata": {
    "title": "Universal SAE J1979 OBD-II Mode $06 Diagnostic Monitor Database",
    "version": "1.0.0",
    "total_monitors": 20,
    "uasid_scaling_formulas": {
      "0x01": {
        "unit": "mV",
        "scale": 0.1,
        "offset": 0.0,
        "formula": "raw * 0.1",
        "description": "Millivolts"
      },
      "0x02": {
        "unit": "V",
        "scale": 0.001,
        "offset": 0.0,
        "formula": "raw * 0.001",
        "description": "Volts"
      },
      "0x04": {
        "unit": "mA",
        "scale": 0.01,
        "offset": -128.0,
        "formula": "(raw - 128) * 0.01",
        "description": "Milliamperes (Bi-directional)"
      },
      "0x07": {
        "unit": "ms",
        "scale": 1.0,
        "offset": 0.0,
        "formula": "raw * 1.0",
        "description": "Milliseconds"
      },
      "0x08": {
        "unit": "ms",
        "scale": 4.0,
        "offset": 0.0,
        "formula": "raw * 4.0",
        "description": "Milliseconds (High Resolution)"
      },
      "0x0B": {
        "unit": "Pa",
        "scale": 0.25,
        "offset": 0.0,
        "formula": "raw * 0.25",
        "description": "Pascals"
      },
      "0x0C": {
        "unit": "kPa",
        "scale": 0.01,
        "offset": 0.0,
        "formula": "raw * 0.01",
        "description": "Kilopascals"
      },
      "0x10": {
        "unit": "°C",
        "scale": 0.1,
        "offset": -40.0,
        "formula": "raw * 0.1 - 40",
        "description": "Degrees Celsius"
      },
      "0x11": {
        "unit": "°C",
        "scale": 1.0,
        "offset": -40.0,
        "formula": "raw * 1.0 - 40",
        "description": "Degrees Celsius (Integer)"
      },
      "0x14": {
        "unit": "%",
        "scale": 0.39215686274509803,
        "offset": 0.0,
        "formula": "raw * (100 / 255)",
        "description": "Percentage (0..100%)"
      },
      "0x15": {
        "unit": "%",
        "scale": 0.0030517578125,
        "offset": -100.0,
        "formula": "raw * (100 / 32768) - 100",
        "description": "Signed Percentage (-100..+100%)"
      },
      "0x21": {
        "unit": "RPM",
        "scale": 0.25,
        "offset": 0.0,
        "formula": "raw * 0.25",
        "description": "Revolutions Per Minute"
      },
      "0x22": {
        "unit": "counts",
        "scale": 1.0,
        "offset": 0.0,
        "formula": "raw * 1",
        "description": "Event / Misfire Counts"
      },
      "0x30": {
        "unit": "ratio",
        "scale": 0.001,
        "offset": 0.0,
        "formula": "raw * 0.001",
        "description": "Dimensionless Ratio / Lambda"
      },
      "0x33": {
        "unit": "g/s",
        "scale": 0.01,
        "offset": 0.0,
        "formula": "raw * 0.01",
        "description": "Grams per second (MAF)"
      },
      "0x35": {
        "unit": "s",
        "scale": 1.0,
        "offset": 0.0,
        "formula": "raw * 1.0",
        "description": "Seconds"
      }
    }
  },
